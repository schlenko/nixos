{
  "layer": "top",
  "position": "top",
  "spacing": 3,

  "margin-top": 5,
  "margin-bottom": -11,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "hyprland/workspaces",
    "custom/cpucat"
  ],

  "modules-right": [
    "wireplumber",
    "backlight",
    "battery",
    "mpris",
    "clock",
    "custom/power"
  ],

  "custom/tab": {
    "format": "[Z]",
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "mpris": {
    "format": "  {artist} - {title} ",
    "format-paused": " 󰐊 {artist} - {title} ",
    "max-length": 37,
    "tooltip": true,
    "player": "spotify"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  "custom/cpucat": {
    "exec": "~/.config/waybar/scripts/catloop.sh",
    "spacing": 1,
    "format": "{}",
    "tooltip": true
  },

  "wireplumber": {
    "scroll-step": 5,
    "format": " {icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },

  "backlight": {
    "device": "intel_backlight",
    "format": " {icon} {percent}% ",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ]
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}% ",
    "format-charging": "󰂄 {capacity}% ",
    "format-plugged": "󱟦 {capacity}% ",
    "format-full": "󰁹 {capacity}% ",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },

  "clock": {
    "format": "{:%m-%d-%Y    %H:%M} "
  }
}
