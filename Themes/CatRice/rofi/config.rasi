configuration {
    modes: "drun";
    sorting-method: "normal";
    show-icons: true;
    matching: "regex";
    drun-match-fields: "name";
    display-run: "menu:";
    display-drun: "Launch:";
}

@theme "tokyo"

* {
    background-color: transparent;
    text-color: @fg0;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

/* =========================
   Floating glass window
   ========================= */

window {
    location: center;
    width: 500px;
    y-offset: -20px;

    border: 2px;
    border-color: #3f3f42;
    border-radius: 20px;

    background-color: rgba(0, 0, 0, 0.1);
}

/* =========================
   Main container
   ========================= */

mainbox {
    background-color: transparent;
    padding: 14px;
}

/* =========================
   Search bar
   ========================= */

inputbar {
    background-color: rgba(48, 32, 55, 0.55);

    border: 1px;
    border-color: rgba(196, 167, 231, 0.28);
    border-radius: 12px;

    padding: 10px 14px;
    spacing: 8px;
}

prompt {
    background-color: transparent;
    text-color: #C4A7E7;
}

entry {
    background-color: transparent;
    text-color: @fg0;

    placeholder: "search";
    placeholder-color: @fg2;
}

/* =========================
   Application list
   ========================= */

listview {
    background-color: transparent;

    margin: 10px 0 0 0;

    columns: 1;
    lines: 8;
    fixed-height: false;
}

/* =========================
   Application entries
   ========================= */

element {
    background-color: transparent;

    padding: 9px 8px;
    spacing: 8px;

    border-radius: 10px;
}

element normal {
    background-color: transparent;
    text-color: @fg0;
}

element normal urgent {
    text-color: @red;
}

element normal active {
    text-color: @blue;
}

/* Selected item */

element selected normal,
element selected active {
    background-color: rgba(196, 167, 231, 0.16);
    text-color: #C4A7E7;
}

/* =========================
   Icons
   ========================= */

element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

/* =========================
   Message
   ========================= */

message {
    margin: 10px 0 0 0;

    border: 1px;
    border-color: rgba(196, 167, 231, 0.20);
    border-radius: 10px;

    background-color: rgba(17, 17, 27, 0.55);
}

textbox {
    padding: 8px 16px;
    background-color: transparent;
    text-color: @fg1;
}