* {
    background-color: transparent;
    text-color: #C4A7E7;

    margin: 0px;
    padding: 0px;
    spacing: 0px;

    font: "Chivo ExtraBold 13";
}

window {
    location: center;
    width: 900px;
    y-offset: -20px;

    border: 2px;
    border-color: #3F3F42;
    border-radius: 20px;

    background-color: rgba(0, 0, 0, 0.1);
}

mainbox {
    padding: 14px;
    spacing: 10px;
    children: [ inputbar, listview ];
    background-color: transparent;
}

inputbar {
    background-color: rgba(0, 0, 0, 0.45);
    border: 1px;
    border-color: rgba(63, 63, 66, 0.8);
    border-radius: 10px;
    padding: 9px 14px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: #C4A7E7;
}

entry {
    background-color: transparent;
    text-color: #C4A7E7;
    placeholder: "search";
    placeholder-color: rgba(196, 167, 231, 0.5);
}

listview {
    background-color: transparent;
    columns: 3;
    lines: 3;
    spacing: 10px;
    fixed-height: true;
}

element {
    orientation: vertical;
    padding: 9px 8px;
    spacing: 6px;
    border-radius: 10px;
}

/* all results: darkened */
element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: rgba(0, 0, 0, 0.35);
    text-color: #C4A7E7;
}

/* selected result: purple tint */
element selected.normal,
element selected.urgent,
element selected.active {
    background-color: rgba(196, 167, 231, 0.22);
    text-color: #E0CFF7;
}

element-icon {
    background-color: transparent;
    size: 200px;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    highlight: none;
}

message {
    margin: 10px 0 0 0;
    border: 1px;
    border-color: rgba(63, 63, 66, 0.8);
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.45);
}

textbox {
    padding: 8px 16px;
    background-color: transparent;
    text-color: #C4A7E7;
}