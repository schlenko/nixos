{
  "layer": "top",
  "position": "top",
  "spacing": 2,

  "margin-top": 3,
  "margin-bottom": -13,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "hyprland/workspaces",
    "custom/cpucat"
  ],

  "modules-center": [
    "network",
    "bluetooth",
    "mpris"
  ],

  "modules-right": [
    "pulseaudio#microphone",
    "wireplumber",
    "backlight",
    "battery",
    "clock"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "custom/cpucat": {
    "exec": "~/.config/waybar/scripts/catloop.sh",
    "spacing": 1,
    "format": "{}",
    "tooltip": true
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰤭 offline",
    "format-disabled": "󰀝 airplane",
    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}",
    "tooltip-format-disconnected": "No connection",
    "max-length": 22,
    "interval": 5,
    "on-click": "kitty -e nmtui"
  },

  "bluetooth": {
    "format": "󰂯 on",
    "format-off": "󰂲 off",
    "format-disabled": "󰂲 off",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
    "max-length": 24,
    "on-click": "kitty -e bluetuith",
    "on-click-right": "bluetoothctl power toggle"
  },

  "mpris": {
  "format": "{player_icon} {artist} - {title}",
  "format-paused": "{status_icon} {artist} - {title}",
  "max-length": 30,
  "player-icons": {
    "default": "󰝚",
    "spotify": "󰓇",
    "firefox": "󰈹",
    "chromium": "",
    "mpv": "󰐹",
    "vlc": "󰕼"
  },
  "status-icons": {
    "paused": "󰏤"
  },
  "tooltip-format": "{player}: {artist} - {title}\n{album}",
  "tooltip-format-paused": "{player} (paused): {artist} - {title}\n{album}",
  "on-scroll-up": "sh -c 'find /tmp/mskip -mmin -0.013 2>/dev/null | grep -q . || { touch /tmp/mskip; playerctl next; }'",
  "on-scroll-down": "sh -c 'find /tmp/mskip -mmin -0.013 2>/dev/null | grep -q . || { touch /tmp/mskip; playerctl previous; }'",
},

  "wireplumber": {
    "scroll-step": 1,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "~/.config/waybar/scripts/volume-slider.sh",
    "on-click-right": "pavucontrol",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },

  "backlight": {
    "device": "intel_backlight",
    "scroll-step": 1,
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "~/.config/waybar/scripts/brightness-slider.sh"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󱟦 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "clock": {
    "format": "{:%m-%d-%Y    %H:%M}"
  },

  "pulseaudio#microphone": {
  "format": "{format_source}",
  "format-source": "󰍬 {volume}%",
  "format-source-muted": "󰍭 muted",

  "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",

  "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
  "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",

  "tooltip-format": "Microphone: {source_desc}\nVolume: {volume}%",
  "tooltip-format-source-muted": "Microphone muted",

  "scroll-step": 5
}
  
}