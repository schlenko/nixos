configuration { show-icons: true; icon-theme: "Papirus"; }

* {
  font: "Chivo ExtraBold 13";
  text: #C4A7E7;
  dim:  #5b4950;
  hover: #1e1e1e;
  border-col: #3f3f42;
}

window {
  location: west;
  anchor: west;
  x-offset: 10px;
  width: 250px;
  /* no height set: the window shrinks to its rows */
  background-color: #0000001a;
  border: 2px;
  border-color: @border-col;
  border-radius: 20px;
  padding: 8px 12px;
}

mainbox  { children: [ listview ]; spacing: 0; background-color: transparent; }

listview {
  fixed-height: false;
  lines: 12;
  columns: 1;
  spacing: 4px;
  scrollbar: false;
  background-color: transparent;
}

element {
  orientation: horizontal;
  padding: 8px 12px;
  spacing: 14px;
  border-radius: 12px;
  background-color: transparent;
  text-color: @text;
}
element normal.normal   { text-color: @text; }
element selected.normal { background-color: @hover; text-color: @text; }

element-icon { size: 32px; vertical-align: 0.5; background-color: transparent; }
element-text { vertical-align: 0.5; text-color: inherit; background-color: transparent; }